{
  "name": "guategeeks-code-studio",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "GuateGeeks Code Studio: autoría por bloques, JavaScript y Python con runtimes locales aislados",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "openspec": "node tools/run-tool.mjs openspec",
    "codegraph": "node tools/run-tool.mjs codegraph",
    "test": "node --test tests/integration/*.test.mjs",
    "test:tools": "node --test tests/tools/*.test.mjs",
    "test:quick": "node tools/test/run.mjs quick",
    "test:affected": "node tools/test/run.mjs affected",
    "test:full": "node tools/test/run.mjs full",
    "test:standalone": "node tools/test/standalone.mjs",
    "workspace:bootstrap": "bash tools/workspace/bootstrap.sh",
    "spec:validate": "node tools/run-tool.mjs openspec validate --all --strict",
    "baseline": "node tools/f0/baseline.mjs",
    "analyze": "node tools/f0/queries.mjs",
    "probe:pxt": "node tools/f0/pxt-probe.cjs",
    "check:mcp": "node tools/f0/mcp-smoke.mjs",
    "browser:build": "node tools/f0/build-browser.mjs",
    "browser:serve": "node tools/f0/serve-browser.mjs",
    "test:browser": "playwright test",
    "serve:pilot": "GG_CONTEXTS=2d,text node tools/f0/serve-browser.mjs"
  },
  "devDependencies": {
    "@babylonjs/core": "9.32.0",
    "@babylonjs/loaders": "9.32.0",
    "@colbymchenry/codegraph": "1.6.2",
    "@fission-ai/openspec": "1.14.3",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@playwright/test": "1.64.1",
    "acorn": "8.19.0",
    "blockly": "13.4.0",
    "dapjs": "2.3.0",
    "jszip": "3.10.1",
    "pako": "2.1.0",
    "pyodide": "314.0.7",
    "quickjs-emscripten-core": "0.32.0"
  },
  "license": "AGPL-3.0-only"
}
