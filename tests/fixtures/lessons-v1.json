    "steps": [
      {
        "id": "story-position",
        "title": "Llega hasta x=60",
        "instructions": "El ejemplo llega a x=40. Cambia uno de los movimientos y pulsa Ejecutar bloques. Después, comprueba la posición.",
        "hints": [
          "Puedes cambiar el primer movimiento de 20 a 40 pasos."
        ],
        "checks": [
          {
            "kind": "position",
            "axis": "x",
            "equals": 60,
            "tolerance": 0.01
          }
        ]
      },
      {
        "id": "story-costume",
        "title": "Declara un cambio de disfraz",
        "instructions": "Conserva o añade el bloque para cambiar al disfraz hero-alt y observa el escenario. Aquí comprobamos que ese bloque está en tu programa; no comprobamos sus píxeles.",
        "hints": [
          "Busca Cambiar disfraz en Apariencia."
        ],
        "checks": [
          {
            "kind": "authored-operation",
            "operation": "setCostume",
            "costume": "hero-alt"
          }
        ]
      }
    ]
  },
  {
