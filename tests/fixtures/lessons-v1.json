        "instructions": "Ejecuta los bloques, enfoca el escenario y pulsa espacio tres veces. Comprobaremos el valor real de Puntos.",
        "hints": [
          "Si te pasas, Ejecutar bloques vuelve a comenzar desde cero."
        ],
        "checks": [
          {
            "kind": "variable",
            "variableId": "gg-pack-score",
            "equals": 3
          }
        ]
      },
      {
        "id": "score-position",
        "title": "Avanza diez pasos por punto",
        "instructions": "El ejemplo avanza cinco pasos. Cámbialo para que tres puntos lleven a hero hasta x=30. Vuelve a ejecutar y consigue tres puntos.",
        "hints": [
          "Cambia el movimiento del evento espacio a 10."
        ],
        "checks": [
          {
            "kind": "position",
            "axis": "x",
            "equals": 30,
            "tolerance": 0.01
          }
        ]
      }
    ]
  },
